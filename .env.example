# Copy to .env and fill in. Never commit .env.
# Twitch: https://dev.twitch.tv/console/apps  (create app, category "Application Integration")
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# YouTube Data API v3 key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
# Kick: https://kick.com/settings/developer  (create app; client credentials)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Discord bot token: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_BOT_TOKEN=
# Post for Me: https://www.postforme.dev dashboard -> API keys
POSTFORME_API_KEY=
# Optional: AI-written clip titles (console.anthropic.com -> API keys). Without it, built-in titles are used.
ANTHROPIC_API_KEY=
